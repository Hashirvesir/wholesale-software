{
  "name": "invenco-desktop",
  "version": "1.0.0",
  "description": "Invenco Wholesaler & POS Desktop Client",
  "main": "main.js",
  "author": "Invenco Systems",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.invenco.wholesaler",
    "productName": "Invenco Wholesaler",
    "directories": {
      "output": "../public/downloads"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "icon.png",
      "artifactName": "Invenco-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Invenco Wholesaler"
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
